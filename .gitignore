# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Python (for future scripts/validate.py)
__pycache__/
*.pyc
.venv/
venv/

# Local Codex working state
.codex/

# Local generated memory stores
memory/cognee/
memory/candidates/

# Orchestrator runtime outputs (generated by CLI)
runtime/orchestrator/runs/**
!runtime/orchestrator/runs/.gitkeep
runtime/orchestrator/latest_*.json
runtime/dispatch/**
!runtime/dispatch/.gitkeep
!runtime/dispatch/previews/.gitkeep
!runtime/dispatch/codex_activation/
!runtime/dispatch/codex_activation/activation-phase37b-preflight/**
!runtime/dispatch/codex_cli_discovery.json
runtime/unittest_last_run.txt
runtime/unittest_result.txt

# Closeout / test-runner scratch (never commit; use OS temp dirs)
runtime/_*
runtime/*.bat
runtime/*.ps1
runtime/test_*.txt
runtime/run_tests*.txt
runtime/unittest_*.txt
runtime/live_*.txt
runtime/go*.bat
runtime/launch_*.bat
runtime/pr_body*.txt
runtime/rebase-*.ps1
test_out.txt
test_output.txt

# Dispatch preview run artifacts (generated by preview_dispatch.py)
logs/dispatch-*.jsonl
