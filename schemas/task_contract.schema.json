{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "relevant_files", "allowed_edit_paths", "acceptance_commands", "turn_budget", "completion_condition", "handoff_path", "forbidden_actions", "derived"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "relevant_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_edit_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "turn_budget": {"type": "integer", "minimum": 1, "maximum": 200},
    "completion_condition": {"type": "string", "minLength": 1},
    "handoff_path": {"type": "string", "minLength": 1},
    "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "derived": {"type": "boolean"}
  }
}
